<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="16dp">

    <!-- คอนเทนเนอร์หลักรวมการ์ดฝั่งซ้ายและสมุดโน้ตฝั่งขวา -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- 1. กรอบการ์ดหลักฝั่งซ้าย (bg_summary_card.png) -->
        <RelativeLayout
            android:id="@+id/layoutMainCard"
            android:layout_width="631dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:background="@drawable/bg_summary_card"
            android:paddingHorizontal="32dp"
            android:paddingTop="42dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- คำแนะนำโจทย์ + ไอคอนคำถาม (ic_question.png) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_question" />

                    <TextView
                        android:id="@+id/tvInstruction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="คำแนะนำโจทย์"
                        android:textColor="#3D2B1F"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ปุ่มฟังเสียง (ic_speaker.png) -->
                <LinearLayout
                    android:id="@+id/btnListen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_speaker" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="คลิกเพื่อฟัง"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- ปุ่มรับเสียงพูด (ic_mic.png) -->
                <LinearLayout
                    android:id="@+id/btnSpeak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_mic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="คลิกเพื่อพูด"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- กล่องแสดงคำตอบของผู้เล่น (bg_inner_time_box.png) -->
                <RelativeLayout
                    android:layout_width="548dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_inner_time_box"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvPlayerAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="แสดงคำตอบของผู้เล่นที่พูดออกมา"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- ปุ่มลูกศรถัดไป สำหรับข้อ 1 และ ข้อ 2 (ic_next_arrow.png) -->
                    <ImageButton
                        android:id="@+id/btnNextInside"
                        android:layout_width="40dp"
                        android:layout_height="30dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentBottom="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_next_arrow"
                        android:visibility="gone" />
                </RelativeLayout>

            </LinearLayout>
        </RelativeLayout>

        <!-- 2. การ์ดสมุดโน้ตฝั่งขวา สำหรับด่าน 3 (bg_notepad.png) -->
        <RelativeLayout
            android:id="@+id/cardNotepad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notepad"
            android:paddingHorizontal="16dp"
            android:paddingTop="42dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;My greatest strength is my problem solving ability and quick adaptability to new technologies.&quot;"
                    android:textColor="#222222"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="&quot;I want to apply my technical skills to build scalable software solutions and learn from expert engineers.&quot;"
                    android:textColor="#222222"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="&quot;I am a Computer Engineering graduate passionate about software development and system architecture.&quot;"
                    android:textColor="#222222"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </RelativeLayout>

    </LinearLayout>

    <!-- 3. โลโก้ป้ายข้อ QUESTION ด้านบนสุด (ic_logo_1 / 2 / 3) -->
    <ImageView
        android:id="@+id/ivQuestionBadge"
        android:layout_width="223dp"
        android:layout_height="97dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:elevation="10dp"
        android:src="@drawable/ic_logo_1" />

    <!-- 4. ปุ่มลูกศรถัดไป สำหรับข้อ 3 (อยู่นอกการ์ดมุมขวาล่าง) -->
    <ImageButton
        android:id="@+id/btnNextOutside"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:layout_alignEnd="@id/layoutContent"
        android:layout_alignBottom="@id/layoutContent"
        android:layout_marginEnd="-6dp"
        android:layout_marginBottom="-6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:elevation="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_next_arrow"
        android:visibility="gone" />

</RelativeLayout>
